# Copy to .env and fill in real values. .env is gitignored - never commit it.

# --- PostgreSQL (agent chat memory, container "postgres") -------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me            # generate: openssl rand -hex 12
POSTGRES_DB=agent_memory

# --- n8n ---------------------------------------------------------------------
# Encryption key for credentials stored inside n8n (incl. Google OAuth tokens).
# Generate once: openssl rand -hex 24
# NEVER change it after credentials exist, and reuse the SAME key when
# restoring/moving the n8n_data volume - otherwise all stored credentials
# become undecryptable.
N8N_ENCRYPTION_KEY=generate-me

# Public base URL n8n uses for webhook + OAuth callback URLs.
# Keep http://localhost:5678 even on the GCP VM (SSH-tunnel OAuth trick, see README).
N8N_PUBLIC_URL=http://localhost:5678

# n8n editor login (owner account). Used by the restore commands in the
# setup cheat sheet to recreate the owner after a Docker wipe.
N8N_OWNER_EMAIL=you@example.com
N8N_OWNER_PASSWORD=change-me           # min 8 chars, 1 number, 1 uppercase

# --- Google OAuth client (Cloud Console -> APIs & Services -> Credentials) --
# Optional but recommended: lets the credential import pre-fill all three
# Google credentials (Gmail / Calendar / Tasks), so only the three
# "Sign in with Google" clicks remain manual after a restore.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The Google test account the agent operates on (its Gmail inbox == its Calendar ID).
# The workflow's calendar nodes read this via {{ $env.GOOGLE_ACCOUNT_EMAIL }}, so you set
# it once here instead of editing the workflow JSON. n8n rejects the "primary" alias.
GOOGLE_ACCOUNT_EMAIL=you@example.com

# --- Misc --------------------------------------------------------------------
TZ=Europe/Vienna

# The LLM model is NOT configured here. It is set in the workflow
# (workflows/email_calendar_assistant.json -> "Ollama Chat Model" node).
# Current development default: gemma4:12b-it-qat on the host's native Ollama
# (http://host.docker.internal:11434).
