{
  "id": "EmailCalAssistM01",
  "name": "Email & Calendar Assistant (MCP tools)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "nodes": [
    {
      "id": "wh-trigger-00001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "a7e0c1b2-assistant-mcp",
      "parameters": {
        "httpMethod": "POST",
        "path": "assistant-mcp",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "agent-000000001",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        280,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "=You are an Email and Calendar Assistant managing the user's Google account (Gmail, Google Calendar, Google Tasks).\n\nCurrent date/time: {{ $now.setZone('Europe/Vienna').toFormat('cccc, yyyy-MM-dd HH:mm') }} (Europe/Vienna). Use this for all date reasoning (today, tomorrow, weekdays, deadlines).\n\nRules:\n- Use tools to get real data. NEVER invent emails, events, or tasks. If a tool fails or returns nothing, say so plainly.\n- When summarizing emails: one line per email \u2014 sender, subject, gist.\n- When creating tasks: Google Tasks stores only the DATE of a deadline, so include the time in the task title, e.g. 'Submit report (due 15:00)'.\n- Before sending an email or creating/changing a calendar event, state in one sentence what you are doing.\n- Keep answers short: at most 8 lines, no filler."
        }
      }
    },
    {
      "id": "llm-ollama-00001",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        120,
        220
      ],
      "parameters": {
        "model": "gemma4:12b-it-qat",
        "options": {
          "keepAlive": "1h",
          "numCtx": 8192,
          "temperature": 0.2
        }
      },
      "credentials": {
        "ollamaApi": {
          "id": "OllamaLocal00001",
          "name": "Ollama local"
        }
      }
    },
    {
      "id": "mem-postgres-001",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [
        280,
        220
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook').first().json.body.sessionId || 'default' }}"
      },
      "credentials": {
        "postgres": {
          "id": "PgMemory00000001",
          "name": "Postgres memory"
        }
      }
    },
    {
      "id": "tool-datetime-01",
      "name": "current_datetime",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [
        440,
        220
      ],
      "parameters": {
        "name": "current_datetime",
        "description": "Returns the precise current date and time (Europe/Vienna). The current date is already provided in your context - only call this if you need the exact minute.",
        "language": "javaScript",
        "jsCode": "const now = new Date();\nreturn now.toISOString() + ' (' + now.toLocaleString('en-AT', { weekday: 'long', timeZone: 'Europe/Vienna' }) + ', Europe/Vienna)';"
      }
    },
    {
      "id": "tool-gmail-read1",
      "name": "read_emails",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        600,
        220
      ],
      "parameters": {
        "operation": "getAll",
        "limit": 10,
        "simple": true,
        "filters": {
          "q": "={{ $fromAI('search_query', 'Gmail search query, e.g. newer_than:1d for the last day, is:unread for unread, from:alice@x.com. Empty string returns the most recent emails.', 'string') }}"
        },
        "options": {},
        "descriptionType": "manual",
        "toolDescription": "Read emails from the Gmail inbox. Optionally filter with search_query (Gmail search syntax)."
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GmailOAuth000001",
          "name": "Gmail (test account)"
        }
      }
    },
    {
      "id": "tool-gmail-send1",
      "name": "send_email",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        760,
        220
      ],
      "parameters": {
        "sendTo": "={{ $fromAI('to', 'recipient email address', 'string') }}",
        "subject": "={{ $fromAI('subject', 'email subject line', 'string') }}",
        "message": "={{ $fromAI('body', 'plain-text email body', 'string') }}",
        "emailType": "text",
        "options": {
          "appendAttribution": false
        },
        "descriptionType": "manual",
        "toolDescription": "Send an email via Gmail. Provide to, subject, and body."
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GmailOAuth000001",
          "name": "Gmail (test account)"
        }
      }
    },
    {
      "id": "tool-mcp-client1",
      "name": "google_tools_mcp",
      "type": "@n8n/n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1.3,
      "position": [
        920,
        220
      ],
      "parameters": {
        "endpointUrl": "http://localhost:5678/mcp/iot26-tools",
        "serverTransport": "httpStreamable",
        "authentication": "none",
        "include": "all",
        "options": {}
      }
    }
  ],
  "connections": {
